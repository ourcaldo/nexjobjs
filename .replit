modules = ["nodejs-18", "web", "bash"]
run = "npm run dev -- -H 0.0.0.0 -p ${PORT:-5000}"

[nix]
channel = "stable-24_05"

[deployment]
run = ["sh", "-c", "npm run dev"]

[[ports]]
localPort = 3000
externalPort = 3000

[workflows]
runButton = "Development Server"

[[workflows.workflow]]
name = "Development Server"
author = "agent"
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev -- -H 0.0.0.0 -p ${PORT:-5000}"
